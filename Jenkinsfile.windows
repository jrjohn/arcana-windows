// Jenkinsfile.windows — multibranch pipeline for arcana-windows (WinUI 3 desktop build)
// Adapted from legacy windows-app-pipeline single-branch job.
//
// Key differences from the legacy XML-embedded script:
//   * `checkout scm` replaces manual bat git clone — multibranch handles auth
//   * `pollSCM` trigger removed                   — multibranch + GitHub webhook drive triggers
//   * `dir("${env.PROJECTS_DIR}/arcana-windows")` removed — multibranch uses workspace root
//   * Arch Qube + Metrics gated `when { branch 'main' }` — main-only post-processing
//   * Post-build messages include branch/PR context
//
// Requires a Jenkins agent labelled `windows` (WinUI 3 build needs MSBuild on Windows).

pipeline {
    // agent none at the top: the Windows box is held only by the "Windows CI" wrapper
    // stage below. With `agent { label 'windows' }` here, the executor stayed occupied
    // while the main-only Architecture Qube stages waited in the LINUX queue — main #127
    // to #130 each finished all Windows work in ~7 min and then sat 23 min in
    // "Waiting for next available executor on 'Jenkins'" until the 30 min timeout
    // aborted them.
    agent none

    options {
        // Raised 30 -> 120: the pipeline-level timeout also covers time spent waiting
        // for the Linux executor of the main-only Arch Qube stages. Per-stage timeouts
        // below keep a genuinely hung Windows step from burning the whole budget.
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '1'))
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        APP_NAME = 'arcana-windows'
        VERSION  = '0.1.0'
        // MSBuild keeps worker nodes alive for ~15 min after a build and Roslyn keeps a
        // VBCSCompiler server; on a shared desktop these pile up between builds and keep
        // eating CPU/RAM long after Jenkins thinks the build is over.
        MSBUILDDISABLENODEREUSE   = '1'
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
    }

    stages {
      stage('Windows CI') {
        agent { label 'windows' }
        // 45 min covers a cold restore + full build/test/publish/MSIX (a healthy run is
        // ~7 min) without letting a hung dotnet step hold the box for two hours.
        options { timeout(time: 45, unit: 'MINUTES') }
        stages {
        stage('Checkout') {
            steps {
                checkout scm
                bat 'git log -1 --oneline'
                script {
                    echo "Branch: ${env.BRANCH_NAME ?: 'unknown'}"
                    echo "PR: ${env.CHANGE_ID ?: 'no'} (target: ${env.CHANGE_TARGET ?: 'n/a'})"
                }
            }
        }

        stage('Restore') {
            steps { bat "dotnet restore Arcana.Windows.sln --force-evaluate --disable-parallel -maxcpucount:1 -nodeReuse:false" }
        }

        stage('Build') {
            steps { bat "dotnet build src\\Arcana.App\\Arcana.App.csproj -c Release -p:Platform=x64 -maxcpucount:1 -nodeReuse:false -p:UseSharedCompilation=false" }
        }

        stage('Unit Tests') {
            steps {
                bat "if exist TestResults rmdir /s /q TestResults"
                bat "dotnet test -c Release -p:Platform=x64 --logger trx --results-directory TestResults --settings tests.runsettings -maxcpucount:1 -nodeReuse:false -p:UseSharedCompilation=false -p:BuildInParallel=false"
            }
        }

        stage('SonarQube Analysis') {
            steps { echo "Windows remote agent requires dotnet-sonarscanner -- skipping" }
        }

        stage('Publish EXE') {
            steps {
                bat "if exist artifacts\\exe rmdir /s /q artifacts\\exe"
                bat "dotnet publish src\\Arcana.App\\Arcana.App.csproj -c Release -p:Platform=x64 -p:WindowsPackageType=None --self-contained -r win-x64 -o artifacts\\exe -maxcpucount:1 -nodeReuse:false -p:UseSharedCompilation=false"
                archiveArtifacts artifacts: 'artifacts/exe/Arcana.App.exe', fingerprint: true
            }
        }

        stage('MSIX Package') {
            steps {
                bat "if exist artifacts\\msix rmdir /s /q artifacts\\msix"
                bat "dotnet publish src\\Arcana.App\\Arcana.App.csproj -c Release -p:Platform=x64 -p:WindowsPackageType=MSIX -p:AppxPackageSigningEnabled=false -p:GenerateAppxPackageOnBuild=true -maxcpucount:1 -nodeReuse:false -p:UseSharedCompilation=false"
                bat "mkdir artifacts\\msix 2>NUL & for /r \"src\\Arcana.App\\AppPackages\" %%f in (*.msix) do @copy /Y \"%%f\" artifacts\\msix\\ & echo MSIX collected & exit /b 0"
                archiveArtifacts artifacts: 'artifacts/msix/*.msix', fingerprint: true, allowEmptyArchive: true
            }
        }

        }
      }

        stage('Architecture Qube') {
            when {
                beforeAgent true
                branch 'main'
            }
            agent { label 'built-in' }
            steps {
                sh '''
                    set +e
                    rm -rf arch-qube-reports && mkdir -p arch-qube-reports
                    c=$(docker create --network devops_default -v /src -v /output arcana.boo/arcana/arch-qube:latest scan /src --framework windows --no-ai --ci --format json,markdown -o /output --threshold 90)
                    tar --exclude=./.git -C . -cf - . | docker cp - "$c":/src
                    docker start -a "$c"
                    rc=$?
                    docker cp "$c":/output/. arch-qube-reports/
                    docker rm -f "$c" >/dev/null 2>&1
                    exit $rc
                '''
            }
        }

        stage('Arch Qube Metrics') {
            when {
                beforeAgent true
                branch 'main'
            }
            agent { label 'built-in' }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    sh "bash /data/projects/_scripts/arch-qube-metrics.sh \$(pwd) arcana-windows || true"
                }
            }
        }
    }

    post {
        success { echo "Pipeline SUCCESS - branch=${env.BRANCH_NAME ?: '?'} pr=${env.CHANGE_ID ?: 'no'}" }
        failure { echo "Pipeline FAILED - branch=${env.BRANCH_NAME ?: '?'} pr=${env.CHANGE_ID ?: 'no'}" }
        always  { echo "Build ${BUILD_NUMBER} done" }
    }
}
